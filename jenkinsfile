pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        IMAGE_NAME = "bazeemme/my-demo-project-repo"
    }

    stages {

        // ---------------- SOURCE CODE ----------------

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/baseemibnbasheer8-dotcom/demo-project.git'
            }
        }

        // ---------------- BUILD ----------------

        stage('Build') {
            steps {
                sh 'mvn clean verify'
            }
        }

        // ---------------- SONAR ----------------

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        // ---------------- QUALITY GATE ----------------

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ---------------- DOCKER ----------------

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                    echo $DOCKER_PASS | docker login \
                    -u $DOCKER_USER \
                    --password-stdin
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                docker build \
                -t $IMAGE_NAME:$BUILD_NUMBER .
                '''
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                docker push \
                $IMAGE_NAME:$BUILD_NUMBER
                '''
            }
        }

        // ---------------- UPDATE GITOPS REPO ----------------

        stage('Update Manifest Repo') {
            steps {

                dir('manifest-repo') {

                    git(
                        branch: 'master',
                        credentialsId: 'github-cred',
                        url: 'https://github.com/baseemibnbasheer8-dotcom/k8s-resources.git'
                    )

                    sh """
                    sed -i 's|tag:.*|tag: "${BUILD_NUMBER}"|' values.yaml
                    """

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-cred',
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {

                        sh '''
                        git config user.email "jenkins@example.com"
                        git config user.name "jenkins"

                        git add .

                        git commit -m \
                        "Updated image tag $BUILD_NUMBER" || true

                        git remote set-url origin \
                        https://$GIT_USER:$GIT_TOKEN@github.com/baseemibnbasheer8-dotcom/k8s-resources.git

                        git push -u origin master
                        '''
                    }
                }
            }
        }
    }
}
